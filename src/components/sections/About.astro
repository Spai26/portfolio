---
import StackTable from '../ui/StackTable.astro';

const stackRows = [
  { level: 'Producción', tech: 'Node.js, TypeScript, Express, Clean Architecture, DDD, CQRS, PostgreSQL, Prisma, Redis' },
  { level: 'Focus actual', tech: 'Observabilidad (Grafana/Prometheus), Stress testing, Optimización de queries, Concurrencia' },
  { level: 'Utilizado en proyectos', tech: 'React, GraphQL, MongoDB, Docker, AWS (EC2, RDS), JWT, Zod, Cloudinary, Stripe, Mercado Pago' },
  { level: 'Aprendiendo', tech: 'Go' },
];
---

<section class="about-preview">
  <div class="container">
    <div class="about-grid">
      <div class="about-content">
        <h2 class="about-title">Sobre mí</h2>
        <p class="about-text">
          Me gusta construir sistemas que funcionan, que escalan, que son eficientes.
          He trabajado en plataformas de automatización de conversaciones, e-commerce con
          arquitectura desde cero, y sistemas educativos en producción.
        </p>
        <p class="about-text">
          Mi enfoque: Clean Architecture, CQRS, CI/CD, y desarrollo guiado por IA.
          No porque esté de moda, sino porque resuelve problemas reales.
        </p>
        <a href="/about" class="btn btn-secondary">Leer más</a>
      </div>

      <div class="about-stack">
        <h3 class="stack-title">Stack técnico</h3>
        <StackTable rows={stackRows} />
      </div>
    </div>
  </div>
</section>

<style>
  .about-preview {
    padding-block: var(--space-24);
    background: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .about-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .about-text {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-4);
  }

  .about-content .btn {
    margin-top: var(--space-4);
  }

  .stack-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
</style>