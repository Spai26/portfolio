---
import Base from '../layouts/Base.astro';
import StackTable from '../components/ui/StackTable.astro';
import ContactForm from '../components/sections/ContactForm.astro';

const stackRows = [
  { level: 'Producción', tech: 'Node.js, TypeScript, Express, Clean Architecture, DDD, CQRS, PostgreSQL, Prisma, Redis' },
  { level: 'Focus actual', tech: 'Observabilidad (Grafana/Prometheus), Stress testing, Optimización de queries, Concurrencia' },
  { level: 'Utilizado en proyectos', tech: 'React, GraphQL, MongoDB, Docker, AWS (EC2, RDS), JWT, Zod, Cloudinary, Stripe, Mercado Pago' },
  { level: 'Aprendiendo', tech: 'Go' },
];
---

<Base
  title="About"
  description="Backend Developer con experiencia en Clean Architecture, DDD, CQRS, TypeScript y Node.js. Estudiante de Ingeniería de Sistemas."
>
  <div class="about-page">
    <header class="about-header">
      <div class="container">
        <h1 class="about-title">About</h1>
      </div>
    </header>

    <div class="about-content">
      <div class="container prose">
        <article class="bio-section">
          <h2>Quién soy</h2>
          <p>
            Construyo sistemas que funcionan en producción. Backend con Node.js y
            TypeScript, aplicando Clean Architecture con DDD y CQRS donde tiene
            sentido — no por moda, porque funciona.
          </p>
          <p>
            Lideré la reestructuración del backend de <strong>DatiHub</strong>,
            armé la arquitectura de <strong>Clostech</strong> desde cero, y llevé
            mi primer proyecto (<strong>AES</strong>) a producción. Estoy metido
            en observabilidad, performance y concurrencia.
          </p>
          <p>
            Actualmente cursando <strong>Ingeniería de Sistemas</strong>,
            combinando años de experiencia práctica con la teoría formal.
          </p>
        </article>

        <article class="bio-section">
          <h2>Experiencia</h2>
          <div class="timeline">
            <div class="timeline-item">
              <span class="timeline-date">2024 — Hoy</span>
              <h3 class="timeline-title">DatiHub</h3>
              <p class="timeline-role">Backend Lead</p>
              <p class="timeline-desc">
                Arquitectura, integraciones CRM, WhatsApp Cloud API. Clean Architecture + CQRS.
                Sistema en producción. ~5.000 conversaciones procesadas por día.
              </p>
            </div>
            <div class="timeline-item">
              <span class="timeline-date">2023 — 2024</span>
              <h3 class="timeline-title">Clostech — Backend Architecture</h3>
              <p class="timeline-role">Backend Developer</p>
              <p class="timeline-desc">
                Arquitectura desde cero para startup de e-commerce: Clean Architecture + DDD táctico, pagos
                (Stripe + Mercado Pago), CI/CD multi-cloud (AWS ECS Fargate + Azure), JWT con refresh tokens.
              </p>
            </div>
          </div>
        </article>

        <article class="bio-section">
          <h2>Stack técnico</h2>
          <StackTable rows={stackRows} />
        </article>

        <article class="bio-section">
          <h2>Cómo trabajo</h2>
          <p>
            Creo en código testeable, separación clara de responsabilidades,
            y patrones de diseño reales — no inventados. La arquitectura no es
           decorativa: existe para resolver problemas concretos.
          </p>
          <p>
            Communication matters. Prefiero documentar decisiones técnicas
            que explicar después por qué algo se rompió.
          </p>
        </article>

        <article class="bio-section">
          <h2>Contacto</h2>
          <p>
            ¿Tenés un proyecto en mente o querés conversar sobre arquitectura backend?
            Contactame directamente a través del formulario o por LinkedIn.
          </p>
          <div class="contact-links">
            <a href="https://www.linkedin.com/in/sergioai93/" class="contact-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://github.com/Spai26" class="contact-link" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </article>
      </div>
    </div>
  </div>

  <ContactForm />
</Base>

<style>
  .about-header {
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .about-title {
    font-size: var(--text-3xl);
    font-weight: 700;
  }

  .about-content {
    padding-block: var(--space-12);
  }

  .bio-section {
    margin-bottom: var(--space-12);
  }

  .bio-section h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .bio-section p {
    margin-bottom: var(--space-4);
    line-height: var(--leading-loose);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .timeline-item {
    padding-left: var(--space-6);
    border-left: 2px solid var(--color-accent-text);
  }

  .timeline-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-text);
    letter-spacing: var(--tracking-wide);
  }

  .timeline-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-block: var(--space-1);
  }

  .timeline-role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .contact-section p {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .contact-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-link:hover {
    color: var(--color-accent-text);
  }
</style>