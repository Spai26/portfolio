# Portfolio Environment Variables
# Copy this file to .env and fill in your values

# Site URL for SEO and OG tags
SITE=https://your-domain.netlify.app

# DatiHub Metrics API endpoint (Prometheus format)
DATIHUB_API=https://your-api-endpoint.com/metrics

# Formspree form ID for contact form
# Get your form ID from https://formspree.io
FORMSPREE_ID=your_form_id_here
